<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>StageCheck</AssemblyName>
    <RootNamespace>PuzzleBoy.StageCheck</RootNamespace>
  </PropertyGroup>

  <!-- The game's content readers and solver, compiled in rather than referenced, so the tool doesn't carry MonoGame. -->
  <ItemGroup>
    <Compile Include="..\..\src\PuzzleBoy.Community\Content\*.cs" Link="Content\%(Filename)%(Extension)" />
    <Compile Include="..\..\src\PuzzleBoy.Community\Play\Solver.cs" Link="Play\Solver.cs" />
  </ItemGroup>

  <!-- The fingerprint list travels with the tool, so a published copy checks stages anywhere. -->
  <ItemGroup>
    <None Include="..\..\scripts\known-atlus-layouts.txt" Link="known-atlus-layouts.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\external\puzzle-boy-engine\src\PuzzleBoy.Rules\PuzzleBoy.Rules.csproj" />
  </ItemGroup>

</Project>
