<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>PuzzleBoyCommunity</AssemblyName>
    <RootNamespace>PuzzleBoy.Community</RootNamespace>
  </PropertyGroup>

  <!-- No MonoGame content pipeline: fonts and data are read from content/ at runtime, and graphics are drawn in code. -->
  <ItemGroup>
    <PackageReference Include="FontStashSharp.MonoGame" />
    <PackageReference Include="MonoGame.Framework.DesktopGL" />
  </ItemGroup>

  <!-- The game reads content/ beside its executable, so a build or an unpacked release runs from anywhere. -->
  <ItemGroup>
    <None Include="..\..\content\**\*" LinkBase="content" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- The game's license and the libraries' notices travel with every build, since each build ships those libraries. -->
  <ItemGroup>
    <None Include="..\..\LICENSE" Link="LICENSE" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\..\THIRD_PARTY_NOTICES.txt" Link="THIRD_PARTY_NOTICES.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\external\puzzle-boy-engine\src\PuzzleBoy.Rules\PuzzleBoy.Rules.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="PuzzleBoy.Community.Tests" />
  </ItemGroup>

</Project>
