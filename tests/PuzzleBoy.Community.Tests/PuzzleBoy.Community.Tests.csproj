<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <OutputType>Exe</OutputType>
    <RootNamespace>PuzzleBoy.Community.Tests</RootNamespace>
    <!-- Test names read as sentences; they don't need doc comments too. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\PuzzleBoy.Community\PuzzleBoy.Community.csproj" />
    <ProjectReference Include="..\..\tools\PuzzleBoy.StageCheck\PuzzleBoy.StageCheck.csproj" />
    <ProjectReference Include="..\..\external\puzzle-boy-engine\src\PuzzleBoy.Rules\PuzzleBoy.Rules.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
